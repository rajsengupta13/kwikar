# ═══════════════════════════════════════════════════════════════
# Kwikar — Environment configuration (EXAMPLE)
#
# Copy this file to `.env` and fill in real values for your
# environment. Never commit the real `.env` file — it is
# gitignored on purpose because it holds live credentials.
#
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows)
# ═══════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────
# development | staging | production
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost/kwikar
APP_LAUNCH_DATE=2026-05-26

# CORS — origin allowed to call the JSON APIs (abd/admin/backend/technician).
# Use "*" for local dev. In production, set this to your real frontend
# origin, e.g. https://kwikar.com (no trailing slash, no wildcard).
CORS_ALLOWED_ORIGIN=*

# ── Database (MySQL) ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=kwikar_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ── Admin panel ──────────────────────────────────────────────────
# Used to gate first-time admin registration. Generate a long random
# string for production, e.g.: openssl rand -hex 32
ADMIN_SECRET=change-me-to-a-long-random-string

# ── Razorpay (payments) ──────────────────────────────────────────
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Mail / SMTP (for notifications, OTPs, receipts) ──────────────
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@kwikar.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@kwikar.com
MAIL_FROM_NAME=Kwikar

# ── Logging ──────────────────────────────────────────────────────
# Folder is relative to backend/
LOG_PATH=logs
LOG_LEVEL=info

# ── Hostinger / CD deploy (PRODUCTION_ENV_FILE secret only) ──────
# Not used locally. When pasting this file's content into the GitHub
# secret PRODUCTION_ENV_FILE, fill in these 4 lines — cd.yml reads
# them and strips them before deploying .env to the server.
HOSTINGER_HOST=your-server.hostinger.com
HOSTINGER_PORT=65002
HOSTINGER_USER=u123456789
HOSTINGER_PATH=~/public_html/
