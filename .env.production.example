# ═══════════════════════════════════════════════════════════════
# Kwikar — PRODUCTION environment template
#
# This file is safe to commit (placeholders only — no real secrets).
# It exists purely as a reference for what the live `.env` should
# contain. The ACTUAL production .env never lives in this repo or
# on disk here — it is delivered to the server only via the
# `ENV_FILE_PRODUCTION` GitHub Actions secret (see .github/workflows/cd.yml).
#
# To go live:
#   1. Copy this file's contents.
#   2. Replace every placeholder below with the real production value.
#   3. Paste the FULL result as the value of the `ENV_FILE_PRODUCTION`
#      repo secret (Settings → Secrets and variables → Actions).
#   4. Never paste real production values into a file that gets committed.
# ═══════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://kwikar.com
APP_LAUNCH_DATE=2026-05-26

# CORS — lock this down to the real frontend origin in production.
# Never use "*" once the app is live.
CORS_ALLOWED_ORIGIN=https://kwikar.com

# ── Database (MySQL — values from Hostinger hPanel → Databases) ──
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_kwikar_db
DB_USERNAME=u123456789_kwikar
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_CHARSET=utf8mb4

# ── Admin panel ──────────────────────────────────────────────────
# Generate fresh for production — never reuse the dev value:
#   openssl rand -hex 32
ADMIN_SECRET=REPLACE_WITH_LONG_RANDOM_PRODUCTION_SECRET

RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_WITH_LIVE_KEY_SECRET


MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@kwikar.com
MAIL_PASSWORD=REPLACE_WITH_MAILBOX_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@kwikar.com
MAIL_FROM_NAME=Kwikar

# ── Logging ──────────────────────────────────────────────────────
LOG_PATH=logs
LOG_LEVEL=warning